{
  "manifest_version": 3,
  "name": "Gripread — ADHD Reader & Focus Reading (PDF, Open Source)",
  "version": "0.3.0",
  "description": "Open-source ADHD reading aid: bolds word starts on any page, auto-on, clean undo. Local-only, no tracking. PDF view + Docs panel.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gripread",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/emphasize.js",
        "lib/rating.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "exclude_matches": [
        "https://docs.google.com/document/*"
      ]
    },
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "content-docs-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "content-docs-init.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "lib/emphasize.js",
        "content-docs.js"
      ],
      "css": [
        "content.css",
        "content-docs.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle Gripread on the current site"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "viewer/pdf.html",
      "can_embed": true
    }
  },
  "short_name": "Gripread"
}
